# SerpApi Key (Google Maps Alternative)
# Get your free key at: https://serpapi.com/
# 100 free searches per month, no credit card required
SERPAPI_KEY=your_serpapi_key_here

# Flask Secret Key (REQUIRED for session security)
# Generate one with: python -c "import os; print(os.urandom(32).hex())"
FLASK_SECRET_KEY=your_random_secret_key_here

# PostgreSQL Database URL
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/leadhunter_db

# System SMTP Configuration for OTP and Welcome emails
SYSTEM_SMTP_HOST=smtp.gmail.com
SYSTEM_SMTP_PORT=465
SYSTEM_SMTP_EMAIL=your_system_email@gmail.com
SYSTEM_SMTP_PASSWORD=your_16_character_gmail_app_password
SYSTEM_SMTP_USE_SSL=true
